{
  "name": "dsh-openai-api",
  "description": "OpenAI-compatible HTTP surface backed by DSH agent sessions: POST /v1/chat/completions, POST /v1/responses, GET /v1/models over the harness webServer + agents services, plus a sidebar panel showing the base URL",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/ui-status.js",
    "lib/client.js",
    "client/build.mjs",
    "client/model.js",
    "client/ui.js",
    "client/entry.js",
    "client/styles.css",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:client": "node client/build.mjs",
    "test": "node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "openai",
    "chat-completions",
    "responses-api",
    "cordis"
  ],
  "license": "MIT"
}
